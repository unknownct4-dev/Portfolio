g;a=c[g]}}else{b=0;a=c[g]}addClass(a,"selected");d.value=a.dataset.value}else if(f.which===13){if(a&&a.textContent)d.value=a.dataset.value}else if(a&&a.textContent){removeClass(a,"selected");a=null}}});if(e){e.addEventListener("mouseenter",function(a){a=e.getElementsByTagName("a");for(var b=0;b<a.length;b++)removeClass(a[b],"selected");e.querySelectorAll("div \x3e div#resultAutoComplete \x3e a").forEach(function(a){a.addEventListener("mouseover",function(b){addClass(a,"selected")});a.addEventListener("mouseleave",
function(b){removeClass(a,"selected")})})});e.addEventListener("mouseleave",function(a){a=e.getElementsByTagName("a");for(var c=0;c<a.length;c++)removeClass(a[c],"selected");b=-1})}});function removeClass(a,b){if(a&&a.parentNode){var d=a.parentNode;d.classList?d.classList.remove(b):d.className=a.className.replace(new RegExp("(^|\\b)"+b.split(" ").join("|")+"(\\b|$)","gi")," ")}}
function addClass(a,b){if(a&&a.parentNode){a=a.parentNode;a.classList?a.classList.add(b):a.className=a.className+(" "+b)}};;